{
  "kind": "collectionType",
  "collectionName": "news_entries",
  "info": {
    "singularName": "news-entry",
    "pluralName": "news-entries",
    "displayName": "News Entry",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.media",
        "blocks.quote",
        "blocks.section",
        "blocks.download-section",
        "blocks.video-embed",
        "blocks.multi-collapsible"
      ]
    },
    "teaser": {
      "type": "text"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "isPinned": {
      "type": "boolean",
      "default": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "string"
    }
  }
}
